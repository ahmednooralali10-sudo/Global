async def MaJoRLoGiN(client_http, data, release_version, server_url):
    try:
        url = f'{server_url}MajorLogin' if server_url.endswith('/') else f'{server_url}/MajorLogin'
        req_headers = DEFAULT_HEADERS.copy()
        req_headers['ReleaseVersion'] = str(release_version)
        response = await client_http.post(url, headers=req_headers, data=data)
        if response.status_code != 200 or len(response.content) < 40:
            return None
        res_proto = MajoRLoGinrEs_pb2.MajorLoginRes()
        try:
            res_proto.ParseFromString(response.content)
        except Exception:
            pass
        if not (res_proto.account_uid and res_proto.token):
            for offset in range(min(128, len(response.content))):
                try:
                    c = MajoRLoGinrEs_pb2.MajorLoginRes()
                    c.ParseFromString(response.content[offset:])
                    if c.account_uid and c.token:
                        res_proto = c
                        break
                except Exception:
                    pass
        if not (res_proto.account_uid and res_proto.token):
            return None
        if not res_proto.key:
            res_proto.key = AES_KEY
        if not res_proto.iv:
            res_proto.iv = AES_IV
        if len(res_proto.key) not in (16, 24, 32) or len(res_proto.iv) != 16:
            return None
        if not res_proto.url:
            res_proto.url = server_url
        return res_proto
    except Exception as e:
        _quiet_print(f'[MAJORLOGIN ERROR] {e}')
        return None

async def GeTLoGiNDaTa(client_http, data, base_url, token, release_version):
    try:
        url = f"{base_url.rstrip('/')}/GetLoginData"
        req_headers = DEFAULT_HEADERS.copy()
        req_headers['ReleaseVersion'] = str(release_version)
        req_headers['Authorization'] = f'Bearer {token}'
        response = await client_http.post(url, headers=req_headers, data=data)
        if response.status_code != 200:
            return None
        res_proto = PorTs_pb2.GetLoginData()
        try:
            res_proto.ParseFromString(response.content)
        except Exception:
            pass
        if res_proto.Online_IP_Port:
            return (res_proto, {})
        parsed = Parser().parse(response.content.hex())
        return (res_proto, await parse_results(parsed))
    except Exception as e:
        _quiet_print(f'[GETLOGIN ERROR] {e}')
        return None

