        if not tg:
            return None
        open_id, access_token, platform = tg
        payload = await PyL(open_id, access_token, platform, client_version)
        if not payload:
            return None
        major_res = await MaJoRLoGiN(client_http, payload, release_version, server_url)
        if not major_res or not major_res.account_uid:
            return None
        gl = await GeTLoGiNDaTa(client_http, payload, major_res.url, major_res.token, release_version)
