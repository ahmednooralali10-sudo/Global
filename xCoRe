        chat_ip, chat_port = chat_addr.rsplit(':', 1) if ':' in chat_addr else (online_ip, online_port)
        return {
            'bot_uid': str(major_res.account_uid), 'token': major_res.token, 'region': major_res.region or region_pref,
            'key': major_res.key or AES_KEY, 'iv': major_res.iv or AES_IV, 'timestamp': major_res.timestamp or int(time.time()),
            'online_ip': online_ip, 'online_port': online_port, 'chat_ip': chat_ip, 'chat_port': chat_port,
            'account_name': res_proto.AccountName or 'Unknown', 'server_url': major_res.url
        }

def xGetFNLToKeN(account_uid, token, kts, key, iv):
    token_bytes = token.encode('utf-8')
    cipher = AES.new(key, AES.MODE_CBC, iv)
    enc_token = cipher.encrypt(pad(token_bytes, 16))
    opcode = bytes.fromhex('830c')
    uid_bytes = int(account_uid).to_bytes(8, byteorder='big')
    kts_bytes = int(kts).to_bytes(4, byteorder='big')
    len_bytes = len(enc_token).to_bytes(8, byteorder='big')
    return opcode + uid_bytes + kts_bytes + len_bytes + enc_token

def CrAuThTK(account_id, jwt_token, timestamp, key, iv):
    try:
        K = bytes.fromhex(key) if isinstance(key, str) else key
        V = bytes.fromhex(iv) if isinstance(iv, str) else iv
        ct = AES.new(K, AES.MODE_CBC, V).encrypt(pad(jwt_token.encode('utf-8'), AES.block_size))
        return (bytes.fromhex('6d19') + int(account_id).to_bytes(8, 'big') + int(timestamp).to_bytes(4, 'big') + len(ct).to_bytes(4, 'big') + ct).hex()
    except:
        return None

