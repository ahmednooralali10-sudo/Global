def _quiet_print(*args, **kwargs):
    try:
        with open('console_details.log', 'a', encoding='utf-8') as _log:
            print(*args, file=_log, sep=kwargs.get('sep', ' '), end=kwargs.get('end', '\n'))
    except OSError:
        pass

def _pb_varint(n):
    if n < 0:
        n = (1 << 64) + n
    out = bytearray()
    while True:
        b = n & 127
        n >>= 7
        if n:
            b |= 128
        out.append(b)
        if not n:
            break
    return bytes(out)

def _pb_tag(f, w):
    return _pb_varint(f << 3 | w)

def _pb_field(f, v):
    if isinstance(v, bool):
        v = int(v)
    if isinstance(v, int):
        return _pb_tag(f, 0) + _pb_varint(v)
    if isinstance(v, str):
        d = v.encode('utf-8')
        return _pb_tag(f, 2) + _pb_varint(len(d)) + d
    if isinstance(v, (bytes, bytearray)):
        d = bytes(v)
        return _pb_tag(f, 2) + _pb_varint(len(d)) + d
    return b''

async def EnC(payload, key, iv):
    cipher = AES.new(key, AES.MODE_CBC, iv)
    return cipher.encrypt(pad(payload, AES.block_size))

def PrOTo(d, key, default=None):
    if not d or not isinstance(d, dict):
        return default
    if key in d:
        return d[key].get('data', default)
    if str(key) in d:
        return d[str(key)].get('data', default)
    return default

async def parse_results(parsed_results):
    result_dict = {}
    for result in parsed_results:
        field_data = {'wire_type': result.wire_type}
        if result.wire_type in ('varint', 'string', 'bytes'):
            field_data['data'] = result.data
        elif result.wire_type == 'length_delimited':
            if hasattr(result.data, 'results'):
                field_data['data'] = await parse_results(result.data.results)
            elif isinstance(result.data, list):
                field_data['data'] = await parse_results(result.data)
            else:
                field_data['data'] = str(result.data)
        result_dict[str(result.field)] = field_data
    return result_dict

async def EnC_PacKeT(HeX, K, V):
    return AES.new(K, AES.MODE_CBC, V).encrypt(pad(bytes.fromhex(HeX), 16)).hex()

async def EnC_Uid(H, Tp):
    e, H = ([], int(H))
    while H:
        e.append(H & 127 | (128 if H > 127 else 0))
        H >>= 7
    return bytes(e).hex() if Tp == 'Uid' else None

async def EnC_Vr(N):
    if N < 0:
        pass
    H = []
    while True:
        BesTo = N & 127
        N >>= 7
        if N:
            BesTo |= 128
        H.append(BesTo)
        if not N:
            break
    return bytes(H)

async def CrEaTe_VarianT(field_number, value):
    field_header = field_number << 3 | 0
    return await EnC_Vr(field_header) + await EnC_Vr(value)

async def CrEaTe_LenGTh(field_number, value):
    field_header = field_number << 3 | 2
    encoded_value = value.encode() if isinstance(value, str) else value
    return await EnC_Vr(field_header) + await EnC_Vr(len(encoded_value)) + encoded_value

async def CrEaTe_ProTo(fields):
    packet = bytearray()
    for field, value in fields.items():
        if isinstance(value, dict):
            nested_packet = await CrEaTe_ProTo(value)
            packet.extend(await CrEaTe_LenGTh(field, nested_packet))
        elif isinstance(value, int):
            packet.extend(await CrEaTe_VarianT(field, value))
        elif isinstance(value, str) or isinstance(value, bytes):
            packet.extend(await CrEaTe_LenGTh(field, value))
    return packet

async def GeneRaTePk(Pk, N, K, V):
    payload = bytes.fromhex(await EnC_PacKeT(Pk, K, V))
    return bytes.fromhex(N) + len(payload).to_bytes(4, 'big') + payload

